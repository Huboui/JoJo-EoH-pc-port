#include "winresrc.h"

#define xstr(s) str(s)
#define str(s) #s

// NEUTRAL LANG
LANGUAGE LANG_NEUTRAL, 0x8

// ICON
IDI_ICON1 ICON "shadps4.ico"

// VERSION
VS_VERSION_INFO VERSIONINFO
 FILEVERSION    1, 0, 0, 0
 PRODUCTVERSION 1, 0, 0, 0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x2L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Bandai Namco Entertainment\0"
            VALUE "FileDescription", "JoJo's Bizarre Adventure: Eyes of Heaven\0"
            VALUE "FileVersion", "1.0.0.0\0"
            VALUE "InternalName", "JoJo EoH\0"
            VALUE "LegalCopyright", "Copyright 2026 Bandai Namco / CyberConnect2\0"
            VALUE "OriginalFilename", "JoJo EoH.exe\0"
            VALUE "ProductName", "JoJo's Bizarre Adventure: Eyes of Heaven\0"
            VALUE "ProductVersion", "1.0.0.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
